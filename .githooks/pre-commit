#!/bin/sh
# SAA 콘텐츠 freeze 가드 (T8) — 검수 기간 무관 SAA 콘텐츠 변경 차단.
# 발효 조건: 레포 루트에 `.saa-frozen` 마커가 있을 때만. 없으면 통과(dormant).
# 허용: 검수 브랜치(saa-review*/review/saa*)에서의 수정루프·flip.
# 설치(1회): git config core.hooksPath .githooks
# 발효/해제: touch .saa-frozen  /  rm .saa-frozen
# 정책 전문: WORKLIST §B-① · docs/superpowers/plans/2026-06-20-saa-rereview-plan.md
#
# 우회가 필요하면 `git commit --no-verify` (권장 안 함 — 검수 기준이 흔들림).

[ -f ".saa-frozen" ] || exit 0   # freeze 비활성 → 통과

# 스테이징된 SAA 콘텐츠(문서·문항) 변경만 본다.
changed=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^flutter_app/assets/content/saa/.*\.(md|questions\.json)$' || true)
[ -z "$changed" ] && exit 0   # SAA 콘텐츠 변경 없음 → 통과

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in
  saa-review*|review/saa*) exit 0 ;;   # 허용: 검수 브랜치(수정루프·flip)
esac

echo "──────────────────────────────────────────────" >&2
echo "🚫 SAA 콘텐츠 freeze 발효 중 (.saa-frozen)" >&2
echo "검수 기간 SAA 콘텐츠는 동결입니다. 스테이징된 변경:" >&2
echo "$changed" | sed 's/^/  - /' >&2
echo "" >&2
echo "허용: 검수 브랜치(saa-review* / review/saa*)에서의 수정루프·flip." >&2
echo "  · 이 변경이 검수 구동이면 saa-review 브랜치에서 커밋하세요." >&2
echo "  · 검수 종료 시: rm .saa-frozen" >&2
echo "  · 부득이 우회: git commit --no-verify (권장 안 함)" >&2
echo "정책: WORKLIST §B-① · docs/superpowers/plans/2026-06-20-saa-rereview-plan.md" >&2
echo "──────────────────────────────────────────────" >&2
exit 1
